# Copy to .env and set your values. React loads REACT_APP_* at build time.
# Vercel: set these in Project → Settings → Environment Variables. MUST use wss:// (HTTPS blocks ws://).
# HiveMQ Cloud (WSS) — browser must use wss:// and port 8884/mqtt
REACT_APP_MQTT_WS_URL=wss://YOUR_CLUSTER.s1.eu.hivemq.cloud:8884/mqtt
REACT_APP_MQTT_USER=WaterQuality
REACT_APP_MQTT_PASS=your_password

# Supabase — use exact names from Supabase (Connect → App Frameworks → React / Create React App).
# Vercel: add these for Production → Redeploy with "Clear cache".
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_key

# Optional: backend API (Map fallback when MQTT offline; readings/alerts use Supabase when set)
# REACT_APP_API_URL=http://localhost:5000/api
